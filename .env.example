# Copy to .env for local use. NEVER commit .env. On Railway, set these as service variables.
#
# The app fails closed: if anything here is missing, malformed, or ambiguous, it refuses to start.
# There is no brokerage configuration. Variables that look like brokerage credentials
# (ALPACA_*, IBKR_*, QUESTRADE_*, WEALTHSIMPLE_*, BROKER_* ...) make the app refuse to start.

# development | test | production
APP_ENV=development

# Must be exactly "simulated". Trading Lab never places real orders.
TRADING_MODE=simulated

# Market data: Tiingo API token (free plan is enough). https://www.tiingo.com
TIINGO_API_TOKEN=

# Optional, for Claude research reports (Phase 8).
# ANTHROPIC_API_KEY=

# Set automatically by Railway's PostgreSQL plugin (Phase 4). Its host is added to the
# egress allowlist; nothing else beyond Tiingo and the Claude API is reachable.
# DATABASE_URL=postgresql://user:password@host:5432/railway

# Starting virtual capital for each simulated account (every bot gets its own).
CAPITAL_BASE_USD=1000000

# Risk limits (hard ceilings are enforced in code; values above them are rejected).
RISK_PER_TRADE_PCT=0.005
MAX_PORTFOLIO_EXPOSURE_PCT=0.30
MAX_OPEN_POSITIONS=3
INTRADAY_LOSS_HALT_PCT=0.03
PEAK_DRAWDOWN_HALT_PCT=0.10

SYMBOLS=SPY,QQQ,IWM
