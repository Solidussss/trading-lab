# Copy to .env for local use. NEVER commit .env. On Railway, set these as service variables.
#
# The app fails closed: if anything here is missing, malformed, or ambiguous, it refuses to start.

# development | test | production
APP_ENV=development

# Must be exactly "paper". Any other value (including "live") aborts startup.
TRADING_MODE=paper

# Alpaca PAPER keys only (from the Paper Trading section of the Alpaca dashboard).
# Paper key IDs start with "PK". Keys that look like live keys ("AK...") are rejected.
# Do NOT also set APCA_API_KEY_ID / APCA_API_SECRET_KEY / APCA_API_BASE_URL - the app treats
# those as ambiguous configuration and refuses to start.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Order submission is OFF until you explicitly approve activation.
# While false, the engine runs end-to-end but only records "would submit" decisions.
ORDER_SUBMISSION_ENABLED=false

# Virtual capital the risk engine sizes against, regardless of the paper account's balance.
# (New Alpaca paper accounts default to $100k; the lab still sizes as if it had $10k.)
CAPITAL_BASE_USD=10000

# Risk limits (hard ceilings are enforced in code; values above them are rejected).
RISK_PER_TRADE_PCT=0.005
MAX_PORTFOLIO_EXPOSURE_PCT=0.30
MAX_OPEN_POSITIONS=3
INTRADAY_LOSS_HALT_PCT=0.03
PEAK_DRAWDOWN_HALT_PCT=0.10

# Instruments
SYMBOLS=SPY,QQQ,IWM
